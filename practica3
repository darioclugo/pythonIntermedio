# Actividad 4 y 5

def calcularPromedio(*num):
    promedio = sum(num) / len(num) if len(num) > 0 else 0

    print(f"El promedio es: {promedio:.2f}" if len(num) > 0 else "Error: No se ingresaron números para promediar")
    return promedio

calcularPromedio(3,4,6)
calcularPromedio(3,4)
calcularPromedio()
